<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- PlatformTarget は指定しない (AnyCPU)。x64 を刻むと PE のマシン種別が AMD64 で固定され、
         Arm64 ネイティブの .NET プロセスがこのアセンブリをロードできなくなる
         (FileLoadException: The assembly architecture is not compatible with the current process architecture)。
         コード側に x64 固有の依存は無く、ポインタ幅依存の箇所は Arm64 でも正しく動作する。 -->
    <ApplicationIcon>../../icon/app.ico</ApplicationIcon>
    <IsPackable>true</IsPackable>
    <PackageId>1llum1n4t1s.AlphaFS</PackageId>
    <Title>1llum1n4t1s.AlphaFS</Title>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <Product>1llum1n4t1s.AlphaFS</Product>
    <Description>AlphaFS is a .NET library providing more complete Win32 file system functionality to the .NET platform than the standard System.IO classes. Features highlights: creating hardlinks, accessing hidden volumes, enumeration of volumes, transactional file operations and much more.</Description>
    <Authors>Alphaleonis,Yomodo,ゆろち</Authors>
    <Copyright>Copyright (C) 2008-2018 Peter Palotas, Jeffrey Jangli, Alexandr Normuradov, 2026 ゆろち</Copyright>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/1llum1n4t1s/1llum1n4t1s.AlphaFS</PackageProjectUrl>
    <PackageOutputPath>../../artifacts</PackageOutputPath>
    <RepositoryUrl>https://github.com/1llum1n4t1s/1llum1n4t1s.AlphaFS</RepositoryUrl>
    <!-- バージョンはリポジトリ直下の Directory.Build.props の <Version> で一元管理 (継承)。 -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- SourceLink とシンボルパッケージ。P/Invoke ラッパーという性質上、利用者側の障害スタックは
         必ず AlphaFS 内部のフレームで止まるため、ファイル名と行番号が出せないと原因に到達できない。
         .NET SDK 8 以降は GitHub 向け SourceLink が同梱されているので、追加の PackageReference は不要。
         dotnet nuget push は隣接する .snupkg を自動で併送する。 -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../icon/app_icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <SubType>Designer</SubType>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <CustomToolNamespace>Alphaleonis.Win32</CustomToolNamespace>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!-- CAS 由来の型 (SecurityPermission / PermissionSet / FileIOPermission 等) は使っていないが、
         NativeError が ERROR_BAD_RECOVERY_POLICY に対して投げる System.Security.Policy.PolicyException
         がこのパッケージへ型フォワードされているため、参照は必須。削除すると CS1069 でビルドできない。 -->
    <PackageReference Include="System.Security.Permissions" Version="10.0.11" />
  </ItemGroup>
  <!-- インクリメンタルビルドを毎回破壊する CleanBinObjBeforeBuild は削除。
       クリーンビルドが必要な場合は `dotnet clean` を明示的に実行する。 -->
  <Target Name="GenerateAppIcon" BeforeTargets="BeforeBuild"
          Inputs="$(MSBuildThisFileDirectory)..\..\icon\app_icon.png;$(MSBuildThisFileDirectory)..\..\icon\generate_icon.ps1"
          Outputs="$(MSBuildThisFileDirectory)..\..\icon\app.ico">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\icon\generate_icon.ps1&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)..\.." />
  </Target>
</Project>
